---
layout: layouts/base.njk
---
<section class="blog-hero">
  <div class="container">
    <span class="eyebrow">Writing</span>
    <h1>Notes on architecture, <em>AI</em>, and the enterprise.</h1>
    <p class="lede">Long-form pieces on what works, what breaks, and what's coming next. New writing also goes out on LinkedIn.</p>
  </div>
</section>

<section class="blog-list">
  <div class="container">
    <div class="blog-list-actions">
      <div class="topic-links">
        <a href="/blog/ai-and-governance/">AI &amp; governance</a>
        <span aria-hidden="true">·</span>
        <a href="/blog/architecture-practice/">Architecture practice</a>
        <span aria-hidden="true">·</span>
        <a href="/blog/case-studies/">Case studies</a>
        <span aria-hidden="true">·</span>
        <a href="/services/insights/">Services insights</a>
      </div>
      <a class="rss-link" href="/blog/feed.xml" aria-label="RSS feed">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3 5.5C12.7 5.5 18.5 11.3 18.5 21M3 12.5C7.7 12.5 11.5 16.3 11.5 21M5 18a2 2 0 1 1 0 .01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/>
        </svg>
        Subscribe via RSS
      </a>
    </div>
    {% if collections.posts.length == 0 %}
      <p class="empty">No posts yet — check back soon.</p>
    {% else %}
      <ol class="post-list">
        {% for post in collections.posts %}
          <li class="post-card">
            {# All posts (own + LinkedIn imports with full body) are hosted
               here. The card always links to the local /blog/{slug}/ page;
               the "From LinkedIn" tag still flags the source for transparency,
               and each post page has a "View original on LinkedIn" link. #}
            <a class="post-card-link" href="{{ post.url }}">
              <div class="post-meta">
                <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
                {% if post.data.source == 'linkedin' %}
                  <span class="source-tag source-tag--linkedin">From LinkedIn</span>
                {% endif %}
              </div>
              <h2 class="post-title">{{ post.data.title }}</h2>
              {% if post.data.excerpt %}
                <p class="post-excerpt">{{ post.data.excerpt }}</p>
              {% endif %}
              <span class="post-cta">Read post →</span>
            </a>
          </li>
        {% endfor %}
      </ol>
    {% endif %}
  </div>
</section>
