---
layout: layouts/base.njk
ogType: article
---
{# Per-post structured data for search engines and AI assistants #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title | escape }}",
  "description": "{{ excerpt | escape }}",
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ date | isoDate }}",
  "author": {
    "@type": "Person",
    "@id": "https://tarun.bulchandanis.com/#person",
    "name": "{{ author or 'Tarun Bulchandani' }}",
    "url": "https://tarun.bulchandanis.com/"
  },
  "publisher": {
    "@type": "Person",
    "@id": "https://tarun.bulchandanis.com/#person",
    "name": "Tarun Bulchandani"
  },
  "url": "https://tarun.bulchandanis.com{{ page.url }}",
  "mainEntityOfPage": "https://tarun.bulchandanis.com{{ page.url }}"{% if image %},
  "image": "{{ image }}"{% endif %},
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".post-lede", ".post-body p:first-of-type"]
  }{% if source == "linkedin" and external %},
  "isBasedOn": "{{ external }}"{% endif %}
}
</script>

{%- set _backHref = "/services/insights/" if section == "services-insights" else "/blog/" -%}
{%- set _backLabel = "All insights" if section == "services-insights" else "All writing" -%}
<article class="post">
  <div class="container container--narrow">
    <a class="post-back" href="{{ _backHref }}">← {{ _backLabel }}</a>

    <header class="post-header">
      <div class="post-meta">
        <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
        {% if source == 'linkedin' %}
          <span class="source-tag source-tag--linkedin">From LinkedIn ↗</span>
        {% endif %}
        {% if author %}
          <span class="post-author">by {{ author }}</span>
        {% endif %}
      </div>
      <h1 class="post-title">{{ title }}</h1>
      {% if excerpt %}<p class="post-lede">{{ excerpt }}</p>{% endif %}
    </header>

    {% if image %}
      <figure class="post-hero">
        <img src="{{ image }}" alt="" loading="lazy">
      </figure>
    {% endif %}

    {# LinkedIn post WITHOUT a full body: show prominent CTA before the excerpt #}
    {% if source == 'linkedin' and external and not has_body %}
      <div class="linkedin-banner">
        <p>Originally published on LinkedIn.</p>
        <a class="btn btn-primary" href="{{ external }}" target="_blank" rel="noopener">Read the full piece on LinkedIn →</a>
      </div>
    {% endif %}

    <div class="post-body">
      {{ content | safe }}
    </div>

    {# LinkedIn post WITH a full body: show subtle attribution at bottom #}
    {% if source == 'linkedin' and external and has_body %}
      <aside class="linkedin-note">
        <p>This article was originally published on LinkedIn. <a href="{{ external }}" target="_blank" rel="noopener">View the original →</a></p>
      </aside>
    {% endif %}

    <footer class="post-footer">
      {% if external and not has_body %}
        <a class="post-external" href="{{ external }}" target="_blank" rel="noopener">View on LinkedIn ↗</a>
      {% endif %}
      <a class="post-back" href="{{ _backHref }}">← {{ _backLabel }}</a>
    </footer>
  </div>
</article>
