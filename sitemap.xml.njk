---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- set staticPages = [
    { url: "/", priority: "1.0", changefreq: "monthly" },
    { url: "/about/", priority: "0.9", changefreq: "monthly" },
    { url: "/intro/", priority: "0.9", changefreq: "monthly" },
    { url: "/now/", priority: "0.7", changefreq: "monthly" },
    { url: "/speaking/", priority: "0.6", changefreq: "monthly" },
    { url: "/uses/", priority: "0.5", changefreq: "monthly" },
    { url: "/press/", priority: "0.5", changefreq: "yearly" },
    { url: "/blog/", priority: "0.9", changefreq: "weekly" },
    { url: "/blog/ai-and-governance/", priority: "0.8", changefreq: "weekly" },
    { url: "/blog/architecture-practice/", priority: "0.8", changefreq: "weekly" },
    { url: "/blog/case-studies/", priority: "0.8", changefreq: "monthly" }
  ] %}
  {%- for p in staticPages %}
  <url>
    <loc>https://tarun.bulchandanis.com{{ p.url }}</loc>
    <changefreq>{{ p.changefreq }}</changefreq>
    <priority>{{ p.priority }}</priority>
  </url>
  {%- endfor %}
  {%- for post in collections.posts %}
  <url>
    <loc>https://tarun.bulchandanis.com{{ post.url }}</loc>
    <lastmod>{{ post.date | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- endfor %}
</urlset>
